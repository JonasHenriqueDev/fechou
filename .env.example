# Copie para .env. Em dev o banco é o Postgres do docker-compose.yml (npm run db:up).
DATABASE_URL="postgresql://orcafacil:orcafacil@localhost:5432/orcafacil"
# Conexão direta (sem pool), usada pelas migrations. Em dev é a mesma.
DATABASE_URL_UNPOOLED="postgresql://orcafacil:orcafacil@localhost:5432/orcafacil"

# Better Auth: gere com `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# Opcional em dev: token do Vercel Blob (vercel env pull). Sem ele, as imagens ficam como data URL no banco.
BLOB_READ_WRITE_TOKEN=""
